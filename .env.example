# ==============================================================================
# LABCARE PRO ENTERPRISE LIMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real credentials to Git.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/labcare_pro_dev
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication & Session Management
# Generate a cryptographically strong 64-char hex secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
SESSION_TTL_HOURS=24
COOKIE_NAME=labcare_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Object Storage Configuration (S3 / Cloudflare R2 / MinIO)
# Leave empty or set to 'local' for local disk storage provider fallback during dev/testing
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=./storage/doctor-assets
OBJECT_STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=labcare-pro-private-assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# External Notification & Payment Provider Stubs / Configuration
EMAIL_PROVIDER_ENABLED=false
EMAIL_SMTP_HOST=smtp.mailgun.org
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@labcarepro.internal

SMS_PROVIDER_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=LABCAR

PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
